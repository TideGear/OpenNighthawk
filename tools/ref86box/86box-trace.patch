+/* PC-parity harness (tools/ref86box/86box-trace.patch): with B86_PORTLOG set, every write to the
+   debug port 0xE9 logs the cycle counter at the start of the OUT, the instructions executed and the
+   value, so a probe program can time instruction blocks (tools/ref86box/timing386.md). */
+extern uint64_t b86_ins;
+static void
+b86_port_log(uint8_t val)
+{
+    static FILE *f;
+    static int   tried;
+    if (!tried) {
+        const char *path = getenv("B86_PORTLOG");
+        tried = 1;
+        if (path && *path)
+            f = fopen(path, "w");
+    }
+    if (f) {
+        fprintf(f, "%llu %llu %u\n", (unsigned long long) tsc, (unsigned long long) b86_ins, val);
+        fflush(f);
+    }
+}
+
+/* With B86_SPKLOG=FILE every write to PIT counter 2 (port 42h), a control word for it (43h, counter
+   bits 2) and port 61h is logged as "emulated-ms port value", the format of DOSBox-X's
+   DBX_SPEAKER_LOG (tools/speaker_parity.py), the milliseconds from the cycle counter. */
+extern double cpuclock;
+static void
+b86_speaker_log(uint16_t port, uint8_t val)
+{
+    static FILE *f;
+    static int   tried;
+    if (!tried) {
+        const char *path = getenv("B86_SPKLOG");
+        tried = 1;
+        if (path && *path)
+            f = fopen(path, "w");
+    }
+    if (f && (port == 0x42 || port == 0x61 || (port == 0x43 && (val >> 6) == 2))) {
+        fprintf(f, "%.6f %02X %02X\n", (double) tsc * 1000.0 / cpuclock, (unsigned) port, (unsigned) val);
+        fflush(f);
+    }
+}
