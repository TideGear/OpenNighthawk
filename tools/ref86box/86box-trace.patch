+/* PC-parity harness: with B86_OPL=FILE every AdLib register write is logged as
+ * "microseconds register value" in emulated time (tools/ref86box/sound86.py). */
+static FILE    *adlib_trace;
+static int      adlib_trace_init;
+static uint8_t  adlib_trace_reg;
+static void   (*adlib_real_write)(uint16_t addr, uint8_t val, void *priv);
+
+static void
+adlib_traced_write(uint16_t addr, uint8_t val, void *priv)
+{
+    if (!adlib_trace_init) {
+        const char *path = getenv("B86_OPL");
+
+        adlib_trace_init = 1;
+        if (path)
+            adlib_trace = fopen(path, "w");
+    }
+    if (adlib_trace) {
+        if ((addr & 1) == 0)
+            adlib_trace_reg = val;
+        else
+            fprintf(adlib_trace, "%llu %02X %02X\n",
+                    (unsigned long long) (cpu_s && cpu_s->rspeed ? ((double) tsc * 1000000.0) / (double) cpu_s->rspeed : 0),
+                    adlib_trace_reg, val);
+    }
+    adlib_real_write(addr, val, priv);
+}
