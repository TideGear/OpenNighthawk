+/* Optional reference capture, before host gain or playback. It observes the
+ * existing emulation-thread buffers; no guest state or timers are changed.
+ * B86_AUDIO is a filename prefix. Streams are native little-endian int32
+ * stereo: sound at SOUND_FREQ, music at MUSIC_FREQ. */
+static void
+b86_audio_capture(const int32_t *buffer, size_t samples, int music)
+{
+    static FILE *stream[2];
+    static int tried[2];
+    const unsigned channel = music != 0;
+    if (!tried[channel]) {
+        tried[channel] = 1;
+        const char *prefix = getenv("B86_AUDIO");
+        if (prefix && *prefix) {
+            char path[4096];
+            snprintf(path, sizeof(path), "%s.%s.pcm", prefix, music ? "music" : "sound");
+            stream[channel] = fopen(path, "wb");
+            if (!stream[channel]) fprintf(stderr, "B86_AUDIO cannot open %s\n", path);
+        }
+    }
+    if (stream[channel]) {
+        fwrite(buffer, sizeof(*buffer), samples, stream[channel]);
+        fflush(stream[channel]);
+    }
+}
