+/* PC-parity harness (tools/ref86box/dosbox-x-auto-video.patch): DBX_AUTO_INPUT holds
+ * "ms|kind|arg;..." and DBX_AUTO_INPUT_AT names a program; when DOS executes it the events are
+ * scheduled in emulated time from that moment. kind k taps a key (arg: one character, or enter,
+ * bs, esc, space; capitals use shift), m moves the mouse to guest pixel x,y (320x200), c moves
+ * and clicks the left button, r injects a raw keyboard byte (hex), d sets the raw mouse driver
+ * position x,y, b presses (1) or releases (0) the left button. DBX_LOOP_* runs a closed loop:
+ * every DBX_LOOP_EVERY ms it appends the state (DBX_LOOP_READS, DS-relative "off:len") to
+ * DBX_LOOP_STATE and waits for the file DBX_LOOP_REPLY<seq> holding one spec line ("stop" ends
+ * the loop); DBX_LOOP_AT names the start program (default DBX_AUTO_INPUT_AT). No host input
+ * device is involved. */
+#include "pic.h"
+#include "mouse.h"
+void Mouse_AutoPosition(float fx, float fy);
+void Mouse_AutoRaw(float x, float y);
+void KEYBOARD_AddBuffer(uint16_t data);
+#include "keyboard.h"
+#include <vector>
+#include <thread>
+#include <chrono>
+#include <ctime>
+/* DBX_WALL_US (microseconds since 1970 UTC) is the wall clock at the exec of DBX_AUTO_INPUT_AT;
+ * from there DOS and the BIOS RTC read it advanced by emulated time, as the Machine's clock does. */
+static bool wall_pinned = false;
+static int64_t wall_us_at_anchor = 0;
+static double wall_pic_at_anchor = 0;
+void dbx_pin_bios_ticks(void);
+bool dbx_pinned_wall(struct tm *out, int *centis) {
+	if (!wall_pinned) return false;
+	const int64_t us = wall_us_at_anchor + (int64_t)((PIC_FullIndex() - wall_pic_at_anchor) * 1000.0);
+	const time_t t = (time_t)(us / 1000000);
+	const struct tm *g = gmtime(&t);
+	if (!g) return false;
+	*out = *g;
+	if (centis) *centis = (int)((us / 10000) % 100);
+	return true;
+}
+namespace {
+struct AutoEv { int kind; int a, b; bool down; };
+std::vector<AutoEv> auto_evs;
+bool auto_armed = true, loop_armed = true;
+void auto_key(int a, bool down) { KEYBOARD_AddKey((KBD_KEYS)a, down); }
+void AutoHandler(Bitu i) {
+	AutoEv &e = auto_evs[i];
+	if (getenv("DBX_AUTO_LOG")) { FILE *f = fopen(getenv("DBX_AUTO_LOG"), "a"); if (f) { fprintf(f, "%.1f event %c %d %d %d\n", (double)PIC_FullIndex(), e.kind, e.a, e.b, (int)e.down); fclose(f); } }
+	if (e.kind == 'k') auto_key(e.a, e.down);
+	else if (e.kind == 'm') Mouse_AutoPosition((e.a + 0.5f) / 320.0f, (e.b + 0.5f) / 200.0f);
+	else if (e.kind == 'b') { if (e.down) Mouse_ButtonPressed(0); else Mouse_ButtonReleased(0); }
+	else if (e.kind == 'r') KEYBOARD_AddBuffer((uint16_t)e.a);
+	else if (e.kind == 'd') Mouse_AutoRaw((float)e.a, (float)e.b);
+}
+int auto_keycode(const std::string &n, bool &shift) {
+	shift = false;
+	if (n == "enter") return KBD_enter;
+	if (n == "bs") return KBD_backspace;
+	if (n == "esc") return KBD_esc;
+	if (n == "space") return KBD_space;
+	if (n.size() != 1) return 0;
+	char c = n[0];
+	if (c >= 'A' && c <= 'Z') { shift = true; c = (char)(c - 'A' + 'a'); }
+	static const char *letters = "qwertyuiopasdfghjklzxcvbnm";
+	for (int k = 0; letters[k]; k++) if (letters[k] == c) return KBD_q + k;
+	if (c >= '1' && c <= '9') return KBD_1 + (c - '1');
+	if (c == '0') return KBD_0;
+	return 0;
+}
+void schedule_spec(const std::string &s) {
+	auto add = [&](double ms, AutoEv e) { auto_evs.push_back(e); PIC_AddEvent(AutoHandler, (pic_tickindex_t)ms, auto_evs.size() - 1); };
+	size_t pos = 0;
+	while (pos < s.size()) {
+		size_t end = s.find(';', pos);
+		if (end == std::string::npos) end = s.size();
+		std::string item = s.substr(pos, end - pos);
+		pos = end + 1;
+		size_t p1 = item.find('|'), p2 = item.find('|', p1 + 1);
+		if (p1 == std::string::npos || p2 == std::string::npos) continue;
+		double ms = atof(item.substr(0, p1).c_str());
+		char kind = item[p1 + 1];
+		std::string arg = item.substr(p2 + 1);
+		if (kind == 'k') {
+			bool shift; int code = auto_keycode(arg, shift);
+			if (!code) continue;
+			if (shift) add(ms, {'k', KBD_leftshift, 0, true});
+			add(ms + 20, {'k', code, 0, true});
+			add(ms + 60, {'k', code, 0, false});
+			if (shift) add(ms + 80, {'k', KBD_leftshift, 0, false});
+		} else if (kind == 'm' || kind == 'c') {
+			int x = atoi(arg.c_str()), y = atoi(arg.substr(arg.find(',') + 1).c_str());
+			add(ms, {'m', x, y, false});
+			if (kind == 'c') { add(ms + 40, {'b', 0, 0, true}); add(ms + 160, {'b', 0, 0, false}); }
+		} else if (kind == 'r') {
+			add(ms, {'r', (int)strtol(arg.c_str(), nullptr, 16), 0, true});
+		} else if (kind == 'd') {
+			int x = atoi(arg.c_str()), y = atoi(arg.substr(arg.find(',') + 1).c_str());
+			add(ms, {'d', x, y, false});
+		} else if (kind == 'b') {
+			add(ms, {'b', 0, 0, arg == "1"});
+		}
+	}
+}
+
+struct LoopCfg {
+	const char *state = nullptr, *reply = nullptr;
+	double every = 200;
+	std::vector<std::pair<unsigned, unsigned>> reads;
+} loop_cfg;
+long loop_seq = 0;
+
+bool read_reply(long seq, std::string &spec) {
+	std::string path = std::string(loop_cfg.reply) + std::to_string(seq);
+	FILE *f = fopen(path.c_str(), "r");
+	if (!f) return false;
+	char line[4096];
+	bool found = fgets(line, sizeof line, f) != nullptr;
+	fclose(f);
+	if (found) {
+		spec = line;
+		while (!spec.empty() && (spec.back() == '\n' || spec.back() == '\r')) spec.pop_back();
+	}
+	return found;
+}
+
+void LoopHandler(Bitu) {
+	uint16_t ds = (uint16_t)(dos.psp() + 0x10 + 0x1e42);
+	long seq = ++loop_seq;
+	FILE *f = fopen(loop_cfg.state, "a");
+	if (f) {
+		fprintf(f, "%ld %.4f max=%lld left=%lld cpu=%lld psp=%04x", seq, (double)PIC_FullIndex(), (long long)CPU_CycleMax,
+			(long long)CPU_CycleLeft, (long long)CPU_Cycles, (unsigned)dos.psp());
+		for (auto &r : loop_cfg.reads)
+			for (unsigned i = 0; i < r.second; i++) fprintf(f, " %02x", mem_readb((((uint32_t)ds << 4) + r.first + i) & 0xFFFFF));
+		fprintf(f, "\n");
+		fclose(f);
+	}
+	std::string spec;
+	int waited = 0;
+	while (!read_reply(seq, spec)) {
+		if (++waited > 60000) { fprintf(stderr, "DBX_LOOP: no reply for tick %ld\n", seq); spec = "stop"; break; }
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	if (spec == "stop") return;
+	schedule_spec(spec);
+	PIC_AddEvent(LoopHandler, (pic_tickindex_t)loop_cfg.every, 0);
+}
+
+void auto_schedule(const char *name) {
+	if (getenv("DBX_AUTO_LOG")) { FILE *f = fopen(getenv("DBX_AUTO_LOG"), "a"); if (f) { fprintf(f, "%.1f exec %s\n", (double)PIC_FullIndex(), name); fclose(f); } }
+	std::string prog(name);
+	for (auto &ch : prog) ch = (char)toupper((unsigned char)ch);
+	auto named = [&](const char *env) {
+		if (!env) return false;
+		std::string want(env);
+		for (auto &ch : want) ch = (char)toupper((unsigned char)ch);
+		return prog.find(want) != std::string::npos;
+	};
+	if (auto_armed && named(getenv("DBX_AUTO_INPUT_AT"))) {
+		auto_armed = false;
+		if (const char *w = getenv("DBX_WALL_US")) { wall_us_at_anchor = atoll(w); wall_pic_at_anchor = PIC_FullIndex(); wall_pinned = true; dbx_pin_bios_ticks(); }
+		if (const char *spec = getenv("DBX_AUTO_INPUT")) schedule_spec(spec);
+	}
+	const char *loop_at = getenv("DBX_LOOP_AT") ? getenv("DBX_LOOP_AT") : getenv("DBX_AUTO_INPUT_AT");
+	if (loop_armed && named(loop_at) && getenv("DBX_LOOP_STATE") && getenv("DBX_LOOP_REPLY")) {
+		loop_armed = false;
+		loop_cfg.state = getenv("DBX_LOOP_STATE");
+		loop_cfg.reply = getenv("DBX_LOOP_REPLY");
+		if (getenv("DBX_LOOP_EVERY")) loop_cfg.every = atof(getenv("DBX_LOOP_EVERY"));
+		if (const char *rd = getenv("DBX_LOOP_READS")) {
+			std::string r(rd);
+			size_t p = 0;
+			while (p < r.size()) {
+				size_t e = r.find(',', p);
+				if (e == std::string::npos) e = r.size();
+				std::string it = r.substr(p, e - p);
+				p = e + 1;
+				size_t c = it.find(':');
+				if (c != std::string::npos)
+					loop_cfg.reads.push_back({(unsigned)strtoul(it.substr(0, c).c_str(), nullptr, 0), (unsigned)strtoul(it.substr(c + 1).c_str(), nullptr, 0)});
+			}
+		}
+		FILE *f = fopen(loop_cfg.state, "w");
+		if (f) fclose(f);
+		PIC_AddEvent(LoopHandler, (pic_tickindex_t)0.01, 0);
+	}
+}
+}
