# Opt-in gate-only override. Supply through CMAKE_PROJECT_INCLUDE and set
# F117R_LOCKSTEP_SCRATCH to a separately prepared whitespace-only test copy.
include_guard(GLOBAL)
function(f117r_use_lockstep_scratch)
  if(NOT TARGET func_lockstep)
    message(FATAL_ERROR "Scratch override requires the func_lockstep target")
  endif()
  if(NOT EXISTS "${F117R_LOCKSTEP_SCRATCH}")
    message(FATAL_ERROR "Set F117R_LOCKSTEP_SCRATCH to the whitespace-only copy")
  endif()
  file(READ "${CMAKE_SOURCE_DIR}/tests/func_lockstep.c" original)
  file(READ "${F117R_LOCKSTEP_SCRATCH}" patched)
  string(REGEX REPLACE "[ \t\r\n]" "" original_flat "${original}")
  string(REGEX REPLACE "[ \t\r\n]" "" patched_flat "${patched}")
  if(NOT original_flat STREQUAL patched_flat)
    message(FATAL_ERROR "Lockstep scratch copy has non-whitespace changes")
  endif()
  get_target_property(sources func_lockstep SOURCES)
  set(replaced FALSE)
  set(updated)
  foreach(source IN LISTS sources)
    if(source STREQUAL "tests/func_lockstep.c" OR source STREQUAL "${CMAKE_SOURCE_DIR}/tests/func_lockstep.c")
      list(APPEND updated "${F117R_LOCKSTEP_SCRATCH}")
      set(replaced TRUE)
    else()
      list(APPEND updated "${source}")
    endif()
  endforeach()
  if(NOT replaced)
    message(FATAL_ERROR "Expected lockstep source was not found")
  endif()
  set_property(TARGET func_lockstep PROPERTY SOURCES "${updated}")
  set_property(TARGET func_lockstep APPEND PROPERTY INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/tests")
  message(STATUS "Gate uses verified whitespace-only lockstep scratch copy")
endfunction()
cmake_language(DEFER CALL f117r_use_lockstep_scratch)
