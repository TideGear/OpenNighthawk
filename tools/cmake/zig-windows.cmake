# Zig 0.14.1, x86-64 Windows. Pass -DF117R_ZIG_EXECUTABLE=/path/to/zig.exe.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(F117R_ZIG_EXECUTABLE "" CACHE FILEPATH "Zig executable")
if(NOT EXISTS "${F117R_ZIG_EXECUTABLE}")
  message(FATAL_ERROR "Set F117R_ZIG_EXECUTABLE to the downloaded Zig executable")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES F117R_ZIG_EXECUTABLE)
set(CMAKE_C_COMPILER "${F117R_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${F117R_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_C_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_AR "${F117R_ZIG_EXECUTABLE}")
set(CMAKE_C_ARCHIVE_CREATE "\"${F117R_ZIG_EXECUTABLE}\" ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "${CMAKE_C_ARCHIVE_CREATE}")
set(CMAKE_C_ARCHIVE_FINISH "")
set(CMAKE_CXX_ARCHIVE_FINISH "")
# Use the real bundled resource compiler, explicitly excluding MSVC headers.
# COFF output is required for the GNU linker; this retains SDL version metadata.
set(CMAKE_RC_COMPILER "${F117R_ZIG_EXECUTABLE}")
set(CMAKE_RC_COMPILER_ARG1 rc)
set(CMAKE_RC_COMPILE_OBJECT "\"${F117R_ZIG_EXECUTABLE}\" rc /:auto-includes gnu /:output-format coff /:target x86_64 <DEFINES> <INCLUDES> <FLAGS> /fo <OBJECT> <SOURCE>")
