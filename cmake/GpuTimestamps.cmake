# Optional profiling integration for the pinned fetched SDL backend.
option(F117_GPU_TIMESTAMPS "Build optional D3D12 timestamp profiling support" OFF)
if(F117_GPU_TIMESTAMPS)
  if(NOT WIN32 OR NOT TARGET SDL3-shared)
    message(FATAL_ERROR "Timestamp profiling requires the pinned fetched Windows SDL build")
  endif()
  set(profile_backend "${sdl3_SOURCE_DIR}/src/gpu/d3d12/SDL_gpu_d3d12.c")
  file(SHA256 "${profile_backend}" profile_source_hash)
  if(NOT profile_source_hash STREQUAL "31158b37c666075715df83d7edde6b64ff7d03477c0ab4b2458d8e5d7a4e3bfb")
    message(FATAL_ERROR "Pinned SDL backend source changed; profiling extension requires review")
  endif()
  file(READ "${profile_backend}" backend_text)
  file(READ "${CMAKE_SOURCE_DIR}/tools/sdl-profile-bridge.inc" bridge_text)
  set(marker "#endif // SDL_GPU_D3D12")
  string(FIND "${backend_text}" "${marker}" marker_at)
  if(marker_at LESS 0)
    message(FATAL_ERROR "Unexpected SDL D3D12 source; refusing profiling extension")
  endif()
  string(REPLACE "${marker}" "/* OpenNighthawk optional profiling extension. */\n${bridge_text}\n${marker}" backend_text "${backend_text}")
  set(generated_backend "${CMAKE_BINARY_DIR}/gpu-profile/SDL_gpu_d3d12.c")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/gpu-profile")
  file(WRITE "${generated_backend}" "${backend_text}")
  get_target_property(sdl_sources SDL3-shared SOURCES)
  set(backend_found FALSE)
  foreach(source IN LISTS sdl_sources)
    if(source MATCHES "SDL_gpu_d3d12[.]c$")
      list(REMOVE_ITEM sdl_sources "${source}")
      set(backend_found TRUE)
    endif()
  endforeach()
  if(NOT backend_found)
    message(FATAL_ERROR "SDL D3D12 source not found on expected target")
  endif()
  set_property(TARGET SDL3-shared PROPERTY SOURCES "${sdl_sources}")
  target_sources(SDL3-shared PRIVATE "${generated_backend}")
  target_include_directories(SDL3-shared PRIVATE "${sdl3_SOURCE_DIR}/src/gpu/d3d12")
endif()
